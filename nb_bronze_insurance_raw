from pyspark.sql import SparkSession
import random
from datetime import datetime, timedelta

# Inizializza Spark Session
spark = SparkSession.builder.getOrCreate()

# Generiamo un dataset sintetico di 3.000 polizze assicurative (Raw Data)
data = []
product_types = ["Auto", "Home", "Life", "Health"]
statuses = ["Active", "Expired", "Cancelled"]

start_base_date = datetime(2023, 1, 1)

for i in range(1, 3001):
    policy_id = f"POL-{10000 + i}"
    client_id = f"CLI-{5000 + random.randint(1, 1500)}"
    product_type = random.choice(product_types)
    
    # Date casuali
    start_date = start_base_date + timedelta(days=random.randint(0, 500))
    expiry_date = start_date + timedelta(days=365) # durata annuale
    
    # Variabili finanziarie e comportamentali
    premium_amount = round(random.uniform(350.0, 1800.0), 2)
    price_increase_pct = round(random.uniform(-0.05, 0.25), 2) # rincaro o sconto
    claims_count = random.choices([0, 1, 2, 3], weights=[70, 20, 8, 2])[0]
    support_tickets = random.choices([0, 1, 2, 4], weights=[60, 25, 10, 5])[0]
    payment_delays = random.choices([0, 1, 2], weights=[75, 20, 5])[0]
    
    # Logica di Churn simulata (chi ha rincari alti e sinistri ha più probabilità di disdire)
    churn_prob = 0.1 + (price_increase_pct * 0.8) + (claims_count * 0.15) + (payment_delays * 0.1)
    churn = 1 if random.random() < churn_prob else 0
    
    data.append((
        policy_id, client_id, product_type, 
        start_date.strftime("%Y-%m-%d"), expiry_date.strftime("%Y-%m-%d"),
        premium_amount, price_increase_pct, claims_count, 
        support_tickets, payment_delays, churn
    ))

# Definizione dello Schema
columns = [
    "Policy_ID", "Client_ID", "Product_Type", "Start_Date", "Expiry_Date",
    "Premium_Amount", "Price_Increase_Pct", "Claims_Count_Last_Year",
    "Support_Tickets", "Payment_Delays", "Churn"
]

# Creazione del DataFrame Spark
df_raw = spark.createDataFrame(data, columns)

# Salvataggio nel Layer Bronze del Lakehouse in formato Delta Table
table_name = "bronze_insurance_raw"
df_raw.write.format("delta").mode("overwrite").saveAsTable(table_name)

print(f"Tabella Bronze '{table_name}' creata con successo con {df_raw.count()} record!")
display(df_raw.limit(5))
